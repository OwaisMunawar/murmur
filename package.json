{
  "name": "murmur",
  "version": "0.1.0",
  "private": true,
  "description": "A private voice journal for iOS and Android. On-device transcription, summaries and question answering over your notes.",
  "author": "Owais Munawwar <owais.munawar@gmail.com> (https://github.com/OwaisMunawar)",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:demo": "EXPO_PUBLIC_DEMO=1 expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "npx expo-doctor@1.20.4",
    "e2e": "maestro test .maestro"
  },
  "dependencies": {
    "@legendapp/list": "3.6.0",
    "@op-engineering/op-sqlite": "18.2.5",
    "@shopify/react-native-skia": "2.13.1",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "jsonrepair": "^3.15.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "0.24.7",
    "react-native-executorch": "0.10.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "sqlite-vec": "^0.1.9",
    "typescript": "~6.0.3"
  },
  "react-native-executorch": {
    "backends": [
      "xnnpack"
    ]
  },
  "op-sqlite": {
    "sqliteVec": true,
    "fts5": true
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/react-native-skia"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
